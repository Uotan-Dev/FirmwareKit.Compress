<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Generate the API reference XML manual for all target frameworks. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>

    <PackageId>FirmwareKit.Compress</PackageId>
    <Authors>Zi_Cai</Authors>
    <Copyright>Copyright (c) 2026 Killy Jack</Copyright>
    <Title>FirmwareKit.Compress</Title>

    <!-- netstandard2.0 不支持 AOT，须关闭其 PublishAot 以避免 NETSDK1207。 -->
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>
    <PublishAot Condition="'$(TargetFramework)' == 'netstandard2.0'">false</PublishAot>

    <Description>A fully-managed C# compression library (no P/Invoke, no native dependencies). Provides compression, decompression, format enumeration and magic-byte detection for gzip, zopfli, zlib, deflate, brotli, xz, lzma, bzip2, lz4 (standard/legacy/lg), lzop and zstd — including a pure-managed XZ (LZMA2) encoder and a real Zopfli deflate encoder.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Uotan-Dev/FirmwareKit.Compress</PackageProjectUrl>
    <PackageReleaseNotes>Initial release: fully-managed compression library covering gzip, zopfli, zlib, deflate, brotli, xz, lzma, bzip2, lz4 (standard/legacy/lg), lzop and zstd, with magic-byte detection and a CLI frontend.</PackageReleaseNotes>
    <PackageTags>compression xz lzma2 zopfli gzip deflate zlib brotli lz4 lzop bzip2 zstd managed pure</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Uotan-Dev/FirmwareKit.Compress</RepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- netstandard2.0 内置无 Brotli，需纯托管 BrotliSharpLib 与 Span 支持。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="BrotliSharpLib" Version="0.3.3" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

</Project>
