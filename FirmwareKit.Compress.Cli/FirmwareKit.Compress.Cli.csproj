<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>FirmwareKit.Compress.Cli</AssemblyName>
    <RootNamespace>FirmwareKit.Compress.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- AOT 发布时仅构建库的 net10.0 目标，并剥离传播的发布属性（见 NETSDK1207）。 -->
    <ProjectReference Include="..\FirmwareKit.Compress\FirmwareKit.Compress.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      UndefineProperties="PublishAot;PublishTrimmed;PublishSingleFile;SelfContained" />
  </ItemGroup>

</Project>
